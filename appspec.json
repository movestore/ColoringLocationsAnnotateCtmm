{
    "version": "1.2",
  "settings": [
    {
  "id": "colorby",
  "name": "Color locations by:",
  "description": "Select an option.",
  "type": "RADIOBUTTONS",
  "defaultValue": "time",
  "options": [
    {
      "value": "time",
      "displayText": "Time"
    },
    {
      "value": "sun",
      "displayText": "Sunlight (sine of the sun's altitude)"
    },
    {
      "value": "moon",
      "displayText": "Moonlight (illuminated fraction of the moon)"
    },
    {
      "value": "season",
      "displayText": "Day length"
    },
    {
      "value": "tropic",
      "displayText": "Calendar day"
    },
    {
      "value": "individual",
      "displayText": "Individual"
    }]
},
{
  "id": "showError",
  "name": "Plot error circles if present in the data",
  "description": "Select an option.",
  "type": "RADIOBUTTONS",
  "defaultValue": true,
  "options": [{
      "value": true,
      "displayText": "True"
    },
    {
      "value": false,
      "displayText": "False"
    }]
}
  ],
  "dependencies": {
    "R": [
	        {
        "name": "ctmm"
      },
      {
        "name":"suncalc"
      }
    ]
  },
  "license": {
    "key": "MIT"
  },
  "language": "eng",
